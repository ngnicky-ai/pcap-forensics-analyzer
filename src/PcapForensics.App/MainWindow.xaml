<Window x:Class="PcapForensics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PcapForensics.App.Controls"
        Title="PCAP 침해사고 분석기" Height="920" Width="1520" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewMouseWheel="Window_PreviewMouseWheel" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{StaticResource WindowBrush}" FontFamily="Malgun Gothic, Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <!-- Ctrl+휠 / Ctrl+'+' / Ctrl+'-' 로 화면 전체 확대·축소 -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 도구 모음 -->
        <Border Background="{StaticResource HeaderBrush}" Padding="14,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding FileTitle}" Foreground="White" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding IocStatus}" Foreground="#94A3B8" HorizontalAlignment="Right" FontSize="11.5"/>
                </StackPanel>
                <!-- 확대 시 버튼이 잘리지 않도록 남은 폭에서 줄바꿈 -->
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="PCAP 침해사고 분석기" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="PCAP 열기" Command="{Binding OpenCommand}"/>
                    <Button Style="{StaticResource ToolButton}" Content="● 실시간 모니터링" Click="Monitor_Click" Foreground="#FCA5A5" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            ToolTip="이 PC 의 모든 네트워크 인터페이스(가상·루프백 포함)를 캡처하고, 멈추면 자동으로 분석합니다."/>
                    <Button Style="{StaticResource ToolButton}" Content="IOC 불러오기" Command="{Binding LoadIocCommand}"
                            ToolTip="IP / 도메인 / URL / 해시 목록(txt)을 불러와 트래픽과 대조합니다."/>
                    <Button Style="{StaticResource ToolButton}" Content="규칙 다시 적용" Command="{Binding ReloadRulesCommand}"
                            ToolTip="rules 폴더의 settings.json / web_attack_rules.json 을 다시 읽어 탐지를 재실행합니다."/>
                    <Button Style="{StaticResource ToolButton}" Content="규칙 폴더" Command="{Binding OpenRulesFolderCommand}"/>
                    <Rectangle Width="1" Height="20" Fill="#334155" Margin="8,4"/>
                    <Button Style="{StaticResource ToolButton}" Content="Suricata 검사" Command="{Binding RunSuricataCommand}"
                            ToolTip="설치된 Suricata 로 현재 PCAP 을 검사해 경보를 탐지 결과에 합칩니다."/>
                    <Button Style="{StaticResource ToolButton}" Content="eve.json 가져오기" Command="{Binding ImportEveCommand}"
                            ToolTip="다른 장비에서 같은 PCAP 을 Suricata 로 검사한 eve.json 을 불러옵니다."/>
                    <Button Style="{StaticResource ToolButton}" Content="ET Open 룰 받기" Command="{Binding UpdateRulesCommand}"
                            ToolTip="무료 ET Open 룰셋을 내려받습니다. settings.json 의 RulesPath 가 비어 있으면 Suricata 검사에 사용됩니다."/>
                    <Rectangle Width="1" Height="20" Fill="#334155" Margin="8,4"/>
                    <Button Style="{StaticResource ToolButton}" Content="HTML 보고서" Command="{Binding ExportHtmlCommand}"/>
                    <Button Style="{StaticResource ToolButton}" Content="CSV 내보내기" Command="{Binding ExportCsvCommand}"/>
                    <Button Style="{StaticResource ToolButton}" Content="파일 일괄 추출" Command="{Binding ExportFilesCommand}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 진행 상태 -->
        <Border Grid.Row="1" Background="#E0E7FF" Padding="14,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="취소" Command="{Binding CancelCommand}"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressText}" Width="260" VerticalAlignment="Center"/>
                <ProgressBar Style="{StaticResource BarProgress}" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" Margin="8,0"/>
            </DockPanel>
        </Border>

        <!-- 시작 안내 -->
        <Border Grid.Row="2" Margin="40" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="10" Background="White"
                Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="PCAP / PCAPNG 파일을 이곳에 끌어다 놓거나" FontSize="20" HorizontalAlignment="Center" Foreground="#334155"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16">
                    <Button Style="{StaticResource PrimaryButton}" Content="파일 열기" Command="{Binding OpenCommand}" Padding="24,10" FontSize="15"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="● 실시간 모니터링" Click="Monitor_Click" Padding="24,10" FontSize="15" Margin="10,0,0,0" Background="#B91C1C"/>
                </StackPanel>
                <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" LineHeight="22"
                           Text="포트 스캔 · 무차별 대입 · 웹 공격/웹셸 · 익스플로잇 킷 · DNS 터널링/DGA · C2 비컨 · ARP 스푸핑 · 평문 인증 정보 · IOC 매칭&#x0a;외부 라이브러리나 Npcap 설치 없이 동작합니다. 모든 시각은 UTC 로 표시됩니다."/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="8" SelectedIndex="{Binding SelectedTabIndex}" Padding="0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">

            <!-- 0. 대시보드 -->
            <TabItem Header="대시보드">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBrush}">
                    <StackPanel Margin="12">
                        <Border CornerRadius="6" Padding="14,10" Background="{Binding VerdictBrush}" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Verdict}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                        </Border>

                        <UniformGrid Columns="6" Margin="-6,0">
                            <Border Style="{StaticResource Card}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="심각" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding CriticalCount}" FontSize="28" FontWeight="Bold" Foreground="#B91C1C"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="높음" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding HighCount}" FontSize="28" FontWeight="Bold" Foreground="#EA580C"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="보통" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding MediumCount}" FontSize="28" FontWeight="Bold" Foreground="#CA8A04"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="패킷" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding PacketCountText}" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding BytesText}" Style="{StaticResource MutedText}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="세션" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding SessionCountText}" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SessionSubText}" Style="{StaticResource MutedText}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="캡처 기간" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding DurationText}" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ArtifactText}" Style="{StaticResource MutedText}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding TrafficCaption}" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="11.5"/>
                                        <TextBlock Text="시간대별 트래픽" Style="{StaticResource SectionTitle}"/>
                                    </DockPanel>
                                    <ctl:TrafficChart Height="190" Values="{Binding TrafficValues}" StartLabel="{Binding TrafficStart}" EndLabel="{Binding TrafficEnd}"/>
                                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="탐지 분류 (색: 최고 심각도)" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding CategoryBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                                    <TextBlock Text="탐지된 위협이 없습니다." Style="{StaticResource MutedText}"
                                               Visibility="{Binding HasFindings, Converter={StaticResource InverseBoolToVis}}"/>
                                    <TextBlock Text="{Binding WarningsText}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"
                                               Visibility="{Binding WarningsText, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="프로토콜 분포 (패킷 수)" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding ProtocolBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="상위 통신 IP (전송량)" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding TalkerBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="상위 서비스 포트 (세션 수)" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding PortBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="외부 목적지 (페이로드 전송량)" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding ExternalBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="4" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="DNS 질의 상위 도메인" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding DomainBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="증거 무결성" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="분석 대상 파일 SHA-256" Style="{StaticResource MutedText}"/>
                                    <TextBox Text="{Binding FileHash, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FontFamily="{StaticResource MonoFont}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="고유 IP 수" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding HostCountText}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 1. 탐지 결과 -->
            <TabItem Header="{Binding FindingsHeader}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="2*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Findings.CountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBox Style="{StaticResource FilterBox}" Text="{Binding Findings.Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="검색 (공백으로 여러 단어)"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Findings.View}" SelectedItem="{Binding SelectedFinding}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40"/>
                                <DataGridTemplateColumn Header="심각도" CellTemplate="{StaticResource SeverityBadge}" Width="62" SortMemberPath="Severity"/>
                                <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="90"/>
                                <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="건수" Binding="{Binding Count}" Width="55"/>
                                <DataGridTextColumn Header="최초 관찰(UTC)" Binding="{Binding FirstSeenText}" Width="165"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <TextBlock Text="탐지 항목을 선택하세요." Style="{StaticResource MutedText}" Margin="16"
                                       Visibility="{Binding SelectedFinding, Converter={StaticResource NullToCollapsed}, ConverterParameter=inverse}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedFinding}"
                                          Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                                <StackPanel Margin="16">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SeverityBadge}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap">
                                        <Run Text="{Binding Category, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding FirstSeenText, Mode=OneWay}"/><Run Text=" ~ "/><Run Text="{Binding LastSeenText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="출발지" Style="{StaticResource MutedText}"/>
                                        <TextBox Grid.Column="1" Text="{Binding SourceIp, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Text="대상" Style="{StaticResource MutedText}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TargetIp, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Text="MITRE" Style="{StaticResource MutedText}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Mitre}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <TextBlock Text="설명" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="20"/>
                                    <TextBlock Text="근거" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
                                    <TextBox Style="{StaticResource CodeBox}" TextWrapping="Wrap" MaxHeight="320"
                                             Text="{Binding Evidence, Mode=OneWay, Converter={StaticResource JoinLines}}"/>
                                    <TextBlock Text="대응 권고" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="10">
                                        <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" LineHeight="20"/>
                                    </Border>
                                    <Button Content="관련 세션 보기" HorizontalAlignment="Left" Margin="0,14,0,0" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.ShowFindingSessionsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 2. 타임라인 -->
            <TabItem Header="{Binding TimelineHeader}">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ComboBox DockPanel.Dock="Left" Width="110" ItemsSource="{Binding TimelineCategories}" SelectedItem="{Binding TimelineCategory}" Margin="0,0,6,0"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="세션 보기" Command="{Binding ShowEventSessionCommand}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Timeline.CountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox Style="{StaticResource FilterBox}" Text="{Binding Timeline.Filter, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Timeline.View}" SelectedItem="{Binding SelectedTimelineEvent}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시간(UTC)" Binding="{Binding TimeText}" Width="165"/>
                            <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="55"/>
                            <DataGridTemplateColumn Header="심각도" Width="62" SortMemberPath="Severity">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left"
                                                Visibility="{Binding Severity, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock Text="{Binding SeverityText}" Foreground="White" FontSize="11.5"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="출발지" Binding="{Binding Source}" Width="130"/>
                            <DataGridTextColumn Header="목적지" Binding="{Binding Destination}" Width="130"/>
                            <DataGridTextColumn Header="내용" Binding="{Binding Summary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 3. 세션 -->
            <TabItem Header="{Binding SessionsHeader}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Sessions.CountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox Style="{StaticResource FilterBox}" Text="{Binding Sessions.Filter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="검색어 예: 192.168.0.5 HTTP / id:1,2,3"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Sessions.View}" SelectedItem="{Binding SelectedSession}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="시작(UTC)" Binding="{Binding StartText}" Width="165"/>
                            <DataGridTextColumn Header="전송" Binding="{Binding TransportText}" Width="45"/>
                            <DataGridTextColumn Header="응용" Binding="{Binding AppProtocol}" Width="75"/>
                            <DataGridTextColumn Header="클라이언트" Binding="{Binding ClientEndpoint}" Width="150"/>
                            <DataGridTextColumn Header="서버" Binding="{Binding ServerEndpoint}" Width="150"/>
                            <DataGridTextColumn Header="서버 이름" Binding="{Binding ServerName}" Width="170"/>
                            <DataGridTextColumn Header="패킷" Binding="{Binding Packets}" Width="55"/>
                            <DataGridTextColumn Header="송신" Binding="{Binding ClientBytesText}" Width="75" SortMemberPath="ClientBytes"/>
                            <DataGridTextColumn Header="수신" Binding="{Binding ServerBytesText}" Width="75" SortMemberPath="ServerBytes"/>
                            <DataGridTextColumn Header="지속" Binding="{Binding DurationText}" Width="65" SortMemberPath="DurationSeconds"/>
                            <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="85"/>
                            <DataGridTextColumn Header="요약" Binding="{Binding Summary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <DockPanel Grid.Row="3">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="이 세션의 패킷 보기" Command="{Binding ShowSessionPacketsCommand}"/>
                            <CheckBox DockPanel.Dock="Right" Content="HEX 보기" IsChecked="{Binding StreamHex}" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Text="{Binding StreamHeader}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="클라이언트 → 서버" Foreground="#B91C1C" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBox Style="{StaticResource CodeBox}" Text="{Binding ClientStreamText, Mode=OneWay}" Foreground="#7F1D1D"/>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="서버 → 클라이언트" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBox Style="{StaticResource CodeBox}" Text="{Binding ServerStreamText, Mode=OneWay}" Foreground="#1E3A8A"/>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- 4. HTTP -->
            <TabItem Header="{Binding HttpHeader}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="세션 보기" Command="{Binding ShowHttpSessionCommand}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Http.CountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox Style="{StaticResource FilterBox}" Text="{Binding Http.Filter, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Http.View}" SelectedItem="{Binding SelectedHttp}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="시간(UTC)" Binding="{Binding TimeText}" Width="165"/>
                            <DataGridTextColumn Header="클라이언트" Binding="{Binding ClientIp}" Width="115"/>
                            <DataGridTextColumn Header="서버" Binding="{Binding ServerIp}" Width="115"/>
                            <DataGridTextColumn Header="메서드" Binding="{Binding Method}" Width="60"/>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/>
                            <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="45"/>
                            <DataGridTextColumn Header="Content-Type" Binding="{Binding ContentType}" Width="170"/>
                            <DataGridTextColumn Header="크기" Binding="{Binding ResponseLengthText}" Width="75" SortMemberPath="ResponseLength"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource CodeBox}" Text="{Binding HttpRequestText, Mode=OneWay}"/>
                        <TextBox Grid.Column="2" Style="{StaticResource CodeBox}" Text="{Binding HttpResponseText, Mode=OneWay}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 5. DNS -->
            <TabItem Header="{Binding DnsHeader}">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Dns.CountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox Style="{StaticResource FilterBox}" Text="{Binding Dns.Filter, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Dns.View}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="시간(UTC)" Binding="{Binding TimeText}" Width="165"/>
                            <DataGridTextColumn Header="클라이언트" Binding="{Binding ClientIp}" Width="120"/>
                            <DataGridTextColumn Header="DNS 서버" Binding="{Binding ServerIp}" Width="120"/>
                            <DataGridTextColumn Header="질의" Binding="{Binding QueryName}" Width="2*"/>
                            <DataGridTextColumn Header="유형" Binding="{Binding QueryType}" Width="55"/>
                            <DataGridTextColumn Header="응답 코드" Binding="{Binding RCodeText}" Width="85"/>
                            <DataGridTextColumn Header="응답" Binding="{Binding AnswersText}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 6. TLS -->
            <TabItem Header="{Binding TlsHeader}">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Tls.CountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox Style="{StaticResource FilterBox}" Text="{Binding Tls.Filter, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Tls.View}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시간(UTC)" Binding="{Binding TimeText}" Width="165"/>
                            <DataGridTextColumn Header="세션" Binding="{Binding SessionId}" Width="50"/>
                            <DataGridTextColumn Header="클라이언트" Binding="{Binding ClientIp}" Width="130"/>
                            <DataGridTextColumn Header="서버" Binding="{Binding ServerIp}" Width="130"/>
                            <DataGridTextColumn Header="포트" Binding="{Binding ServerPort}" Width="50"/>
                            <DataGridTextColumn Header="SNI (접속 도메인)" Binding="{Binding Sni}" Width="*"/>
                            <DataGridTextColumn Header="버전" Binding="{Binding Version}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 7. 인증 정보 -->
            <TabItem Header="{Binding CredentialsHeader}">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Credentials.CountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox Style="{StaticResource FilterBox}" Text="{Binding Credentials.Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="예: 성공 / admin / FTP"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Credentials.View}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시간(UTC)" Binding="{Binding TimeText}" Width="165"/>
                            <DataGridTextColumn Header="프로토콜" Binding="{Binding Protocol}" Width="110"/>
                            <DataGridTextColumn Header="클라이언트" Binding="{Binding ClientIp}" Width="120"/>
                            <DataGridTextColumn Header="서버" Binding="{Binding ServerIp}" Width="120"/>
                            <DataGridTextColumn Header="포트" Binding="{Binding ServerPort}" Width="50"/>
                            <DataGridTextColumn Header="계정" Binding="{Binding Username}" Width="140"/>
                            <DataGridTextColumn Header="비밀번호" Binding="{Binding Password}" Width="140"/>
                            <DataGridTextColumn Header="결과" Binding="{Binding ResultText}" Width="70"/>
                            <DataGridTextColumn Header="비고" Binding="{Binding Detail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 8. 추출 파일 -->
            <TabItem Header="{Binding FilesHeader}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="선택 파일 저장" Command="{Binding SaveSelectedFileCommand}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Files.CountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox Style="{StaticResource FilterBox}" Text="{Binding Files.Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="예: 실행 파일 / Flash / 해시값"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Files.View}" SelectedItem="{Binding SelectedFile}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="시간(UTC)" Binding="{Binding TimeText}" Width="165"/>
                            <DataGridTextColumn Header="출처" Binding="{Binding Source}" Width="80"/>
                            <DataGridTextColumn Header="호스트" Binding="{Binding Host}" Width="170"/>
                            <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="실제 형식" Binding="{Binding Kind}" Width="140"/>
                            <DataGridTextColumn Header="분류" Binding="{Binding CategoryText}" Width="85"/>
                            <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="75" SortMemberPath="Size"/>
                            <DataGridTextColumn Header="엔트로피" Binding="{Binding Entropy, StringFormat=F2}" Width="60"/>
                            <DataGridTextColumn Header="SHA256" Binding="{Binding Sha256}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <TextBox Grid.Row="3" Style="{StaticResource CodeBox}" Text="{Binding FilePreviewText, Mode=OneWay}"/>
                </Grid>
            </TabItem>

            <!-- 9. 패킷 -->
            <TabItem Header="{Binding PacketsHeader}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Packets.CountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox Style="{StaticResource FilterBox}" Text="{Binding Packets.Filter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="검색어 예: 10.0.0.5 DNS / sid:12 (세션) / no:100 (프레임 번호)"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Packets.View}" SelectedItem="{Binding SelectedPacket}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No." Binding="{Binding Index}" Width="60"/>
                            <DataGridTextColumn Header="시간(UTC)" Binding="{Binding TimeText}" Width="190"/>
                            <DataGridTextColumn Header="출발지" Binding="{Binding Source}" Width="170"/>
                            <DataGridTextColumn Header="목적지" Binding="{Binding Destination}" Width="170"/>
                            <DataGridTextColumn Header="프로토콜" Binding="{Binding ProtocolName}" Width="80"/>
                            <DataGridTextColumn Header="길이" Binding="{Binding Length}" Width="55"/>
                            <DataGridTextColumn Header="정보" Binding="{Binding Info}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <TextBox Grid.Row="3" Style="{StaticResource CodeBox}" Text="{Binding PacketDetailText, Mode=OneWay}"/>
                </Grid>
            </TabItem>

            <!-- 10. IDS 경보 -->
            <TabItem Header="{Binding IdsHeader}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding IdsSourceText}" Style="{StaticResource MutedText}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="세션 보기" Command="{Binding ShowAlertSessionCommand}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding IdsAlerts.CountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox Style="{StaticResource FilterBox}" Text="{Binding IdsAlerts.Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="예: EXPLOIT_KIT / 2016184 / 192.168.0.5 / 제외"/>
                    </DockPanel>
                    <TextBox DockPanel.Dock="Bottom" Style="{StaticResource CodeBox}" TextWrapping="Wrap" Height="96" Margin="0,6,0,0"
                             Text="{Binding AlertDetailText, Mode=OneWay}"/>
                    <DataGrid ItemsSource="{Binding IdsAlerts.View}" SelectedItem="{Binding SelectedAlert}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시간(UTC)" Binding="{Binding TimeText}" Width="165"/>
                            <DataGridTemplateColumn Header="심각도" CellTemplate="{StaticResource SeverityBadge}" Width="62" SortMemberPath="Severity"/>
                            <DataGridTextColumn Header="우선" Binding="{Binding Priority}" Width="45"/>
                            <DataGridTextColumn Header="sid" Binding="{Binding Sid}" Width="75"/>
                            <DataGridTextColumn Header="시그니처" Binding="{Binding Signature}" Width="3*"/>
                            <DataGridTextColumn Header="출발지" Binding="{Binding Source}" Width="150"/>
                            <DataGridTextColumn Header="목적지" Binding="{Binding Destination}" Width="150"/>
                            <DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="2*"/>
                            <DataGridTextColumn Header="세션" Binding="{Binding SessionId}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="100%"
                           ToolTip="Ctrl + 마우스 휠 또는 Ctrl + '+' / '-' 로 확대·축소, Ctrl + 0 으로 원래 크기"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
