<Window x:Class="PcapForensics.App.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PcapForensics.App.Controls"
        Title="실시간 모니터링 - PCAP 침해사고 분석기" Height="880" Width="1480" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
        PreviewMouseWheel="Window_PreviewMouseWheel" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 머리말 -->
        <Border Background="{StaticResource HeaderBrush}" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="● 모니터링 시작" Command="{Binding StartCommand}" Padding="18,7" FontSize="14"/>
                    <Button Content="■ 중지하고 분석" Command="{Binding StopCommand}" Padding="18,7" FontSize="14" Margin="6,0,0,0" Foreground="White" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#B91C1C" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#991B1B"/></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="실시간 모니터링" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"
                               Text="선택한 모든 인터페이스(실제·가상·루프백)를 동시에 캡처해 pcapng 로 저장하고, 중지하거나 제한에 도달하면 자동으로 분석합니다."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Npcap 없음 / 경고 -->
        <StackPanel Grid.Row="1">
            <Border Background="#FEE2E2" Padding="16,8" Visibility="{Binding AvailabilityError, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding AvailabilityError}" Foreground="#991B1B" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>
            <Border Background="#FFEDD5" Padding="16,8" Visibility="{Binding WarningText, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding WarningText}" Foreground="#9A3412" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="430"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 설정 -->
            <Grid IsEnabled="{Binding IsIdle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource SmallButton}" Content="전체" Command="{Binding SelectAllCommand}"/>
                                <Button Style="{StaticResource SmallButton}" Content="연결된 것만" Command="{Binding SelectConnectedCommand}"/>
                                <Button Style="{StaticResource SmallButton}" Content="해제" Command="{Binding SelectNoneCommand}"/>
                                <Button Style="{StaticResource SmallButton}" Content="새로고침" Command="{Binding RefreshCommand}"/>
                            </StackPanel>
                            <TextBlock Text="1. 캡처할 인터페이스" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding LibraryText}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,6,0,0"/>
                        <DataGrid ItemsSource="{Binding Devices}" IsReadOnly="False" SelectionUnit="FullRow" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="이름" Binding="{Binding Device.DisplayName}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="유형" Binding="{Binding Device.Kind}" Width="75" IsReadOnly="True"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding Device.Status}" Width="65" IsReadOnly="True"/>
                                <DataGridTextColumn Header="주소" Binding="{Binding Device.AddressText}" Width="2*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Device.Description}" Margin="40,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="2. 제한과 옵션" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="최대 용량(MB)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FilterBox}" Text="{Binding MaxSizeMB, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="3" Text="최대 시간(분)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="4" Style="{StaticResource FilterBox}" Text="{Binding MaxMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="0 이면 시간 제한 없음"/>
                        </Grid>
                        <TextBlock Text="{Binding MemoryText}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MemoryRisk}" Value="True">
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox Content="무차별(Promiscuous) 모드" IsChecked="{Binding Promiscuous}" Margin="0,0,18,4"
                                      ToolTip="이 PC 로 향하지 않은 패킷도 받습니다. 지원하지 않는 어댑터는 일반 모드로 자동 전환됩니다."/>
                            <CheckBox Content="중지하면 자동으로 분석" IsChecked="{Binding AutoAnalyze}" Margin="0,0,18,4"/>
                        </WrapPanel>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="폴더 열기" Command="{Binding OpenFolderCommand}"/>
                            <TextBlock Text="{Binding OutputDirectory, StringFormat=저장 위치: {0}}" Style="{StaticResource MutedText}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding OutputDirectory}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 오른쪽: 실시간 현황 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="3. 모니터링 현황" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid Columns="5">
                            <StackPanel><TextBlock Text="경과 시간" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ElapsedText}" FontSize="22" FontWeight="Bold"/></StackPanel>
                            <StackPanel><TextBlock Text="패킷" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding PacketsText}" FontSize="22" FontWeight="Bold"/></StackPanel>
                            <StackPanel><TextBlock Text="전송률" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding RateText}" FontSize="22" FontWeight="Bold"/></StackPanel>
                            <StackPanel><TextBlock Text="저장 파일" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding FileSizeText}" FontSize="22" FontWeight="Bold"/></StackPanel>
                            <StackPanel><TextBlock Text="손실(드롭)" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding DropsText}" FontSize="22" FontWeight="Bold"/></StackPanel>
                        </UniformGrid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SizeLabel}" FontSize="12" Margin="0,0,0,3"/>
                                <ProgressBar Style="{StaticResource BarProgress}" Value="{Binding SizeRatio, Mode=OneWay}" Foreground="{Binding SizeBrush}" Height="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding TimeLabel}" FontSize="12" Margin="0,0,0,3"/>
                                <ProgressBar Style="{StaticResource BarProgress}" Value="{Binding TimeRatio, Mode=OneWay}" Foreground="{Binding TimeBrush}" Height="10"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="초당 전송량 (최근 2분)" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,2"/>
                        <ctl:TrafficChart Height="120" Values="{Binding TrafficValues}" StartLabel="2분 전" EndLabel="지금"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="인터페이스별 수신" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding InterfaceStats}" MaxHeight="150" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="인터페이스" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="유형" Binding="{Binding Kind}" Width="75"/>
                                <DataGridTextColumn Header="패킷" Binding="{Binding Packets}" Width="90"/>
                                <DataGridTextColumn Header="바이트" Binding="{Binding Bytes}" Width="90"/>
                                <DataGridTextColumn Header="손실" Binding="{Binding Dropped}" Width="60"/>
                                <DataGridTextColumn Header="오류" Binding="{Binding Error}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="최근 패킷 (최신 300개, 새 패킷이 위)" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding RecentPackets}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No." Binding="{Binding Index}" Width="70"/>
                                <DataGridTextColumn Header="시간(UTC)" Binding="{Binding TimeText}" Width="190"/>
                                <DataGridTextColumn Header="출발지" Binding="{Binding Source}" Width="170"/>
                                <DataGridTextColumn Header="목적지" Binding="{Binding Destination}" Width="170"/>
                                <DataGridTextColumn Header="프로토콜" Binding="{Binding ProtocolName}" Width="70"/>
                                <DataGridTextColumn Header="길이" Binding="{Binding Length}" Width="55"/>
                                <DataGridTextColumn Header="정보" Binding="{Binding Info}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="저장한 캡처 분석하기" Command="{Binding AnalyzeLastCommand}"
                        Visibility="{Binding HasLastCapture, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
